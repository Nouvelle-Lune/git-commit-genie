.vscode/**
.vscode-test/**
src/**
out/**
# Ship only the two webpack bundles and their license notices. tsconfig.json also emits
# per-module CommonJS into dist/, and those stale files used to be packaged into the vsix.
dist/**
!dist/extension.js
!dist/webview.js
!dist/extension.js.LICENSE.txt
!dist/webview.js.LICENSE.txt
webview-ui/**
node_modules/**
# vsce gives every "!" pattern absolute priority over the positive rules, so this must list
# exactly the files WebviewProvider.ts loads (the css pulls the font in). A broader
# "!node_modules/@vscode/codicons/dist/**" would drag the demo page and icon list back in.
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig*.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

webpack.config.js
vscode-test.config.mjs
.bmad-core/**
.clinerules/**
.gemini/**
.github/**
.kilocode/**
.idea/**
.kilocodemodes
.vsixmanifest

.env
.env.*

.claude/**
.venv/**
__pycache__/**
.python-version
uv.lock
*.log
coverage/

docs_/**

DEVELOPMENT.md
TODO.md

# Scripts directory
scripts/**

# No positive rule matches media/**, so the README images ship as-is. Do not add a
# "!media/**" negation here: vsce negations always win, and it would re-include the
# macOS metadata that this rule is meant to keep out.
**/.DS_Store

# Ignore Git Commit Genie templates
.gitgenie/**

draft.json

.mydocs/**

# Exclude all test artifacts
test/**
tests/**
src/test/**
**/*.test.*
**/*.spec.*
